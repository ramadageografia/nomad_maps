fetch("data/festivals.json")
  .then(res => res.json())
  .then(festivals => initMap(festivals));

function initMap(festivals) {
  const map = L.map("festivalMap").setView([20, 0], 2);

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: "&copy; OpenStreetMap"
  }).addTo(map);

  festivals.forEach(f => {
    if (!f.Latitude || !f.Longitude) return;

    L.circleMarker([f.Latitude, f.Longitude], {
      radius: 6,
      color: "#00ffcc",
      fillOpacity: 0.8
    })
      .addTo(map)
      .bindPopup(`
        <strong>${f["Nome do Festival"]}</strong><br>
        ${f.País}<br>
        <em>${f.Vertente || ""}</em><br><br>
        <a href="festival.html?id=${encodeURIComponent(f["Nome do Festival"])}">
          Consultoria de viagem
        </a>
      `);
  });
}
